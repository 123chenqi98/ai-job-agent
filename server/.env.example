# 复制本文件为 .env 并填入真实值；.env 不会提交到 git
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
# 飞书国内版填 open.feishu.cn，Lark 企业版填 open.larkoffice.com
FEISHU_BASE_URL=open.larkoffice.com
# 网申表所在 wiki 节点，与内嵌多维表格中的两个数据表 ID
FEISHU_WIKI_NODE=your_wiki_node_token
FEISHU_BOARD_TABLE_ID=tblxxxxxxxxxxxx
FEISHU_JOBS_TABLE_ID=tblxxxxxxxxxxxx
PORT=8787

# 本地简历 PDF（可选）：默认读 server/data/resume.pdf，也可填绝对路径覆盖
# RESUME_PDF_PATH=/Users/you/Desktop/resume.pdf

# 火山方舟豆包（可选）：不配置时飞书/简历解析仍可用，AI 画像与 JD 分析显示未配置
# 控制台：https://console.volcengine.com/ark → API Key 与「推理接入点」(ep-xxxxxxxx)
# ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ARK_MODEL=ep-xxxxxxxxxxxxxxxx
# ARK_BASE_URL=ark.cn-beijing.volces.com

# 站点访问门禁（可选）：两项同时配置后所有 /api 数据接口需登录，留空则不启用（本地开发免登录）
# 密码哈希生成：npx tsx server/src/auth.ts "你的密码"
# 签名密钥生成：openssl rand -hex 32（更换后所有已登录设备需重新登录）
# ACCESS_PASSWORD_HASH=scrypt$<saltHex>$<hashHex>
# AUTH_SECRET=<64位十六进制随机串>
